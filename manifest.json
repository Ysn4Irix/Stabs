{
  "manifest_version": 3,
  "name": "Stabs: Tab Preservation & Telegram Backup",
  "version": "1.1.3",
  "description": "Periodically preserve open tabs and synchronize session backups with Telegram.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.telegram.org/*"
  ]
}
